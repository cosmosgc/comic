APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Social login (OAuth 2.0). Fill the client id/secret of each provider app.
# Register the callback URL `{APP_URL}/auth/{provider}/callback` there.
# Leave a provider blank to hide its button.

# Google: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Discord: https://discord.com/developers/applications
# Create an application, then open OAuth2 → General.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=

# GitHub: https://github.com/settings/developers
# Create a new OAuth App (not a GitHub App).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=

# X / Twitter: https://developer.x.com/en/portal/dashboard
# Create an app with OAuth 2.0 enabled and the read users scopes.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Remote host deployment (admin Deploy panel + `php artisan deploy:host`).
# FTP_ROOT is the remote directory that must hold the Laravel project
# (artisan, composer.json, ...). The update refuses to run if it doesn't.
# FTP_PUBLIC_DIR is the web root inside FTP_ROOT (usually `public`).
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_ROOT=/
FTP_PUBLIC_DIR=public
FTP_SSL=true
FTP_SSL_VERIFY=false
FTP_TIMEOUT=30
FTP_FRESH_CONNECTION=false

# Upload limits (must stay below nginx client_max_body_size and PHP limits).
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_POST_MB=100

# What's-new manager: GitHub repo scanned for PRs without a changelog entry.
CHANGELOG_GITHUB_REPO=cosmosgc/comic
# CHANGELOG_GITHUB_TOKEN=
CHANGELOG_GITHUB_PER_PAGE=30
# Sequential upload tuning: single requests stay under this size so even a
# 1 MB nginx cap survives; bigger images are recompressed in the browser.
UPLOAD_SAFE_SINGLE_KB=900
UPLOAD_COMPRESS_MAX_DIM=2048
UPLOAD_HUGE_FILE_MB=50

# External tag lookup (E-Hentai API, https://ehwiki.org/wiki/API).
# E-Hentai needs NO api key. Optional cookies unlock ExHentai / excluded content.
EH_API_URL=https://api.e-hentai.org/api.php
EH_SEARCH_URL=https://e-hentai.org/
EH_LOOKUP_LIMIT=3
EH_TIMEOUT=10
EH_CACHE_TTL=3600
EH_IPB_MEMBER_ID=
EH_IPB_PASS_HASH=
EH_IGNEOUS=
EXHENTAI_ENABLED=false

# Full-comic import from E-Hentai (Admin → Importar). These are only the
# initial defaults: editing them in the import view saves to the DB and
# the DB wins. Keep the delay: E-Hentai rate-limits aggressive scrapers.
EHIMPORT_HTML_TIMEOUT=15
EHIMPORT_IMAGE_TIMEOUT=45
EHIMPORT_DELAY_MS=1200
EHIMPORT_CHUNK=3
EHIMPORT_MAX_INDEX_PAGES=25
EHIMPORT_MAX_PAGES=600
EHIMPORT_MAX_IMAGE_MB=20
EHIMPORT_MAX_ATTEMPTS=3
# Relay for image downloads when the host blocks hath ports (cURL error 7).
# Must end with the url parameter. Empty = direct only.
#EHIMPORT_IMAGE_PROXY=https://images.weserv.nl/?url=
# Queue politeness: pauses and rate ceiling so neither E-Hentai (509)
# nor the host firewall flag the downloads.
EHIMPORT_DELAY_MS=1200
EHIMPORT_DELAY_JITTER_MS=800
EHIMPORT_IMAGE_DELAY_MS=3000
EHIMPORT_MAX_PER_MINUTE=20
EHIMPORT_PREVIEW_TTL=3600
EHIMPORT_STATE_TTL=21600

# Server-to-server transfer (Admin → Comics → Enviar p/ remoto).
# On the RECEIVING site, set the shared secret:
TRANSFER_API_TOKEN=
# On the SENDING site, point at the receiver + repeat its secret:
#TRANSFER_REMOTE_URL=http://177.190.68.79:3000/comic/public
#TRANSFER_REMOTE_TOKEN=
TRANSFER_TIMEOUT=60
TRANSFER_CHUNK=2
